{
  "name": "note-draft-mcp",
  "version": "0.1.0",
  "description": "MCP server that saves Markdown articles as DRAFTS on your own note.com account (unofficial API; publishing is always manual).",
  "license": "MIT",
  "type": "module",
  "bin": {
    "note-draft-mcp": "dist/index.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "start": "node dist/index.js"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.1",
    "marked": "^18.0.14",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^22.20.4",
    "typescript": "^5.9.3",
    "vitest": "^5.0.2"
  }
}
